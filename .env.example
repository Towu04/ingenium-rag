# ============================================================================
# Ingenium RAG — Environment Configuration Template
# ============================================================================
# Copy this file to `.env` and fill in your credentials / overrides.
# Loaded automatically by `src/config.py` and `src/etl/sharepoint.py`.
# `.env` is gitignored — never commit secrets.

# --- Microsoft Entra ID (Azure AD) App Registration (SharePoint mode only) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- SharePoint Online Target(s) ---
# Single site (backwards-compatible):
SHAREPOINT_HOSTNAME=company.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/12345001-INT
SHAREPOINT_DRIVE_NAME=Documents

# Optional multi-site configuration (choose one):
# SHAREPOINT_SITE_PATHS=/sites/12345001-INT,/sites/12345002A-INT
# SHAREPOINT_SITES_FILE=data/sharepoint_sites.tsv

# Optional temporary Graph Explorer token (for quick testing without App Registration)
TEMP_BEARER_TOKEN=

# --- ETL, Chunking & Telemetry Guards ---
# ETL_WORKERS=4
# SKIP_ARCHIVE_FOLDERS=true
# MAX_XLSX_ROWS_PER_SHEET=300
# MAX_CHILD_CHUNKS_PER_DOC=1500

# --- Compute, Embedding & Retrieval Defaults (tuned for 8 GB laptops) ---
# DEVICE=mps
# EMBEDDING_BATCH_SIZE=8
# EMBEDDING_MAX_LENGTH=320
# RETRIEVE_K=10
# RERANKER_MAX_LENGTH=1024
# RERANKER_MIN_SCORE=0.0
# HF_HUB_OFFLINE=0

# --- Optional Project Taxonomy Overrides ---
# DEFAULT_PROJECT_NAME=
# BUILDING_ALIASES={"west-wing": "West Wing"}

# --- Optional Local OpenAI-Compatible LLM (Ollama / vLLM) ---
# Leave unset to use the deterministic ExtractiveStubLLM.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=
